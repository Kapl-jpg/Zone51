  m_text: "\u041E\u0431\u044A\u0435\u043A\u0442 \u2116 410  \u043C\u043E\u0436\u0435\u0442
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u0442\u0435\u043B\u0435\u043A\u0438\u043D\u0435\u0437:\n\n\u041D\u0430\u0436\u043C\u0438
    \u041B\u041A\u041C, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0434\u043D\u044F\u0442\u044C
    \u043F\u0440\u0435\u0434\u043C\u0435\u0442.\n\n\u0417\u0430\u0436\u043C\u0438
    \u041F\u041A\u041C, \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u0440\u044F\u0434\u0438\u0442\u044C
    \u0431\u0440\u043E\u0441\u043E\u043A \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0430.
    \n\n\u041D\u0430\u0436\u043C\u0438 \u041B\u041A\u041C \u0435\u0449\u0435 \u0440\u0430\u0437,
    \u0447\u0442\u043E\u0431\u044B \u0435\u0433\u043E \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u044C."
